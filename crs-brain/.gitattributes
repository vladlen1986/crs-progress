# Cross-platform line-ending safety for CRS Brain.
# Without this, a commit from a Windows machine (or git core.autocrlf=true) can
# rewrite the macOS launchers to CRLF, which makes them fail on the Mac with
# "bad interpreter: /bin/bash^M". Lock every text type explicitly.

# Default: let git normalize text, but never guess for the files below.
*                text=auto

# Unix scripts MUST stay LF — they are executed by /bin/bash on macOS.
*.command       text eol=lf
*.sh            text eol=lf

# App source stays LF on every platform (Node reads either, LF keeps diffs clean).
*.js            text eol=lf
*.html          text eol=lf
*.css           text eol=lf
*.json          text eol=lf
*.md            text eol=lf

# Windows batch files stay CRLF (cmd.exe convention).
*.bat           text eol=crlf

# Native module payloads and archives are binary — git must never touch them.
*.node          binary
*.dll           binary
*.exe           binary
*.dylib         binary
*.so            binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.zip           binary
